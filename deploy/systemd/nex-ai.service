[Unit]
Description=NEX AI Platform Backend
After=network.target

[Service]
Type=simple
User=shiva
WorkingDirectory=/home/shiva/nex-ai/backend
EnvironmentFile=/home/shiva/nex-ai/backend/.env
ExecStart=/home/shiva/nex-ai/backend/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 30 --ws websockets --ws-max-size 8192 --ws-ping-interval 20 --ws-ping-timeout 20 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/shiva/nex-ai/backend

[Install]
WantedBy=multi-user.target
